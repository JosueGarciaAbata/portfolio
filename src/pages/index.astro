---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import ProjectsHighlightedPosts from '~/components/widgets/ProjectsHighlightedPosts.astro';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Software Engineer Portfolio — Josue Garcia',
  ignoreTitleTemplate: true,
};

const skillGroups = [
  {
    title: 'Backend',
    icon: 'tabler:server-2',
    skills: [
      'Java',
      'Spring Boot',
      'Spring Cloud',
      'Spring Security',
      'REST APIs',
      'Microservices',
      'JWT',
      'Node.js',
      'NestJS',
      'FastAPI',
      'gRPC',
      'PHP',
      'Laravel',
      'Go',
    ],
  },
  {
    title: 'Frontend',
    icon: 'tabler:device-laptop',
    skills: ['Angular', 'React', 'TypeScript', 'JavaScript', 'HTML', 'CSS', 'Tailwind CSS'],
  },
  {
    title: 'Databases',
    icon: 'tabler:database',
    skills: ['PostgreSQL', 'MySQL', 'Oracle', 'Redis', 'JPA / Hibernate', 'Citus (distributed)', 'PostGIS', 'SQL'],
  },
  {
    title: 'AI & Computer Vision',
    icon: 'tabler:brain',
    skills: [
      'AI Assistants (RAG)',
      'Computer Vision',
      'Deep Learning',
      'YOLOv11',
      'U-Net',
      'CNN',
      'OCR',
      'Fuzzy Logic',
      'Genetic Algorithms',
      'Model Evaluation',
      'PyTorch',
      'TensorFlow',
    ],
  },
  {
    title: 'Testing & Quality',
    icon: 'tabler:checkup-list',
    skills: ['JUnit 5', 'Mockito', 'JaCoCo', 'SonarQube', 'JMeter', 'OWASP ZAP', 'Selenium', 'Playwright', 'Postman'],
  },
  {
    title: 'DevOps & Cloud',
    icon: 'tabler:cloud-cog',
    skills: [
      'Docker',
      'Docker Compose',
      'Kubernetes',
      'Helm',
      'Jenkins',
      'GitHub Actions',
      'CI/CD',
      'Nginx',
      'AWS',
      'Azure',
    ],
  },
  {
    title: 'Messaging & Integration',
    icon: 'tabler:topology-star-3',
    skills: ['RabbitMQ', 'gRPC', 'Eureka', 'API Gateway', 'WebSocket', 'OpenAPI / Swagger'],
  },
  {
    title: 'Methods & Tools',
    icon: 'tabler:tools',
    skills: ['Scrum', 'Kanban', 'Scrumban', 'Agile', 'Git', 'Linux', 'Maven', 'Vite', 'Odoo', 'Python'],
  },
];

const experience = {
  role: 'Software Developer',
  company: 'Kronhos',
  period: 'May 2026 – Aug 2026',
  highlights: [
    "Built an internal AI assistant that answers staff questions in Spanish using the company's own documents and tickets, as a web chat and on WhatsApp.",
    'Created the admin panel to set up several assistants, each with its own behavior and the actions it is allowed to perform, plus users with roles and permissions.',
    'Connected spreadsheets and web pages as sources, and set up automatic testing and deployment for the backend and frontend.',
  ],
  tags: ['Python', 'FastAPI', 'Angular', 'PostgreSQL', 'AI Assistants', 'WhatsApp', 'CI/CD'],
  href: getPermalink('kronhos-ai-assistant', 'post'),
};

const certifications = [
  {
    name: 'AWS Certified AI Practitioner',
    issuer: 'Amazon Web Services',
    issued: 'Issued Sep 22, 2026',
    valid: 'Valid until Sep 22, 2029',
    id: 'd8a08634715d4aac8046dc7b2128784b',
    href: 'https://aws.amazon.com/verification',
  },
];

const contactLinks = [
  { label: 'Email', value: 'josuegarcab2@hotmail.com', href: 'mailto:josuegarcab2@hotmail.com', icon: 'tabler:mail' },
  {
    label: 'LinkedIn',
    value: 'in/josue-joel-garcia-abata',
    href: 'https://www.linkedin.com/in/josue-joel-garcia-abata-07ab94297/',
    icon: 'tabler:brand-linkedin',
  },
  {
    label: 'GitHub',
    value: 'JosueGarciaAbata',
    href: 'https://github.com/JosueGarciaAbata',
    icon: 'tabler:brand-github',
  },
];

const chip =
  'inline-flex items-center rounded-full bg-blue-50 dark:bg-slate-800 text-blue-700 dark:text-blue-300 ring-1 ring-blue-200 dark:ring-slate-700 px-3 py-1 text-sm font-medium';
---

<Layout metadata={metadata}>
  <!-- Hero (Home) ******************* -->

  <div id="home" class="scroll-mt-[96px] md:scroll-mt-[88px]">
    <Hero
      actions={[
        {
          variant: 'primary',
          text: 'Download CV',
          href: '/cv/Josue_Garcia_en.pdf',
          target: '_blank',
          icon: 'tabler:download',
        },
        { text: 'View projects', href: '#projects' },
      ]}
      sideImage={{ src: '~/assets/images/profile.jpg', alt: 'Josue Garcia profile photo' }}
    >
      <Fragment slot="title">Software Engineer</Fragment>

      <Fragment slot="subtitle">
        <span class="block text-lg md:text-2xl font-semibold text-default dark:text-white mb-3">
          Java, Spring Boot, React & PostgreSQL
        </span>
        Software Engineer focused on full stack development with Java, Spring Boot, Angular, React and PostgreSQL. I build
        APIs, dashboards and microservice-based systems.
      </Fragment>
    </Hero>
  </div>

  <!-- Experience & certifications ************** -->

  <section id="experience" class="scroll-mt-[96px] md:scroll-mt-[88px]">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-6 py-12 md:py-16">
      <div class="mb-10 md:max-w-3xl">
        <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">Experience</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading mt-2">Work and certifications</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div
          class="lg:col-span-2 rounded-xl bg-white dark:bg-slate-800 ring-1 ring-gray-200 dark:ring-slate-700 p-6 shadow-sm"
        >
          <div class="flex items-center gap-2 mb-1">
            <Icon name="tabler:briefcase" class="w-5 h-5 text-blue-600 dark:text-blue-400" />
            <h3 class="font-bold text-xl dark:text-slate-200">{experience.role} — {experience.company}</h3>
          </div>
          <p class="text-sm text-muted dark:text-slate-400 mb-4">{experience.period}</p>
          <ul class="list-disc pl-5 space-y-2 text-muted dark:text-slate-400">
            {experience.highlights.map((item) => <li>{item}</li>)}
          </ul>
          <div class="flex flex-wrap gap-2 mt-5">
            {experience.tags.map((tag) => <span class={chip}>{tag}</span>)}
          </div>
          <a
            href={experience.href}
            class="inline-flex items-center gap-1 mt-5 font-semibold text-blue-700 dark:text-blue-300 hover:underline"
          >
            Read more about this project
            <Icon name="tabler:arrow-right" class="w-4 h-4" />
          </a>
        </div>

        <div>
          {
            certifications.map((cert) => (
              <div class="rounded-xl bg-white dark:bg-slate-800 ring-1 ring-gray-200 dark:ring-slate-700 p-6 shadow-sm">
                <div class="flex items-center gap-2 mb-1">
                  <Icon name="tabler:certificate" class="w-5 h-5 text-blue-600 dark:text-blue-400" />
                  <h3 class="font-bold text-xl dark:text-slate-200">{cert.name}</h3>
                </div>
                <p class="text-sm text-muted dark:text-slate-400 mb-4">{cert.issuer}</p>
                <p class="text-muted dark:text-slate-400">{cert.issued}</p>
                <p class="text-muted dark:text-slate-400">{cert.valid}</p>
                <p class="text-xs text-muted dark:text-slate-400 mt-3 break-all">Validation number: {cert.id}</p>
                <a
                  href={cert.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 mt-4 font-semibold text-blue-700 dark:text-blue-300 hover:underline"
                >
                  Verify on AWS
                  <Icon name="tabler:external-link" class="w-4 h-4" />
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Featured projects ************** -->

  <div id="projects" class="scroll-mt-[96px] md:scroll-mt-[88px]">
    <ProjectsHighlightedPosts
      classes={{ container: 'max-w-screen-2xl' }}
      title="Featured projects"
      linkText="All projects"
      information="A selection of projects across backend platforms, distributed systems, ERP customization and applied computer vision. The focus is on complete systems: APIs, databases, deployment, integrations and real business workflows."
      postIds={[
        'vehicle-monitoring-plate-recognition',
        'iron-zone-gym-management-odoo',
        'petsafe-veterinary-clinic-management',
        'hospital-management-system',
      ]}
    />
  </div>

  <!-- Skills ************************* -->

  <section id="skills" class="scroll-mt-[96px] md:scroll-mt-[88px] relative">
    <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    <div class="relative max-w-screen-2xl mx-auto px-4 md:px-6 py-12 md:py-16">
      <div class="mb-10 md:max-w-3xl">
        <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">Skills</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading mt-2">What I work with</h2>
        <p class="mt-3 text-lg text-muted dark:text-slate-400">
          Technologies I use to build full stack systems, from backend services and frontend interfaces to databases,
          testing, Docker-based environments, CI/CD and cloud fundamentals.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          skillGroups.map((group) => (
            <div class="rounded-xl bg-white dark:bg-slate-800 ring-1 ring-gray-200 dark:ring-slate-700 p-5 shadow-sm">
              <div class="flex items-center gap-2 mb-4">
                <Icon name={group.icon} class="w-5 h-5 text-blue-600 dark:text-blue-400" />
                <h3 class="font-bold text-lg dark:text-slate-200">{group.title}</h3>
              </div>
              <div class="flex flex-wrap gap-2">
                {group.skills.map((skill) => (
                  <span class={chip}>{skill}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- About ************************* -->

  <section id="about" class="scroll-mt-[96px] md:scroll-mt-[88px]">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-6 py-12 md:py-16">
      <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-start">
        <div>
          <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">About me</p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading mt-2 mb-6">
            From idea to working software
          </h2>
          <div class="flex flex-wrap gap-2">
            <span class={chip}>Full Stack Development</span>
            <span class={chip}>Cloud Engineering</span>
            <span class={chip}>Databases</span>
            <span class={chip}>Infrastructure</span>
            <span class={chip}>Distributed Systems</span>
          </div>
        </div>
        <div class="space-y-4 text-lg text-muted dark:text-slate-400 leading-relaxed">
          <p>
            I'm Josué García, a Software Engineer who enjoys building systems that go from an idea to working software.
            Most of my work combines Java and Spring services, Angular and React interfaces, PostgreSQL databases,
            Docker-based environments and API-driven architectures.
          </p>
          <p>
            What interests me most is what happens underneath a working system: how data is modeled and queried, how
            services communicate, how applications are deployed, and how infrastructure supports reliability as the
            system grows.
          </p>
          <p>
            I have also worked with applied AI, from an internal AI assistant for a company to computer vision projects
            where the problem involves detection, recognition or decision support, and I hold the AWS Certified AI
            Practitioner certification. I see it as an interesting area to integrate into software systems.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact *********************** -->

  <section id="contact" class="scroll-mt-[96px] md:scroll-mt-[88px] relative">
    <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    <div class="relative max-w-screen-2xl mx-auto px-4 md:px-6 py-12 md:py-16">
      <div>
        <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">Contact</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading mt-2 mb-4">Let's talk</h2>
        <p class="text-lg text-muted dark:text-slate-400 mb-8 max-w-2xl">
          Open to opportunities, collaboration and technical conversations around full stack development, backend
          systems, databases, infrastructure and cloud engineering.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
          {
            contactLinks.map((c) => (
              <a
                href={c.href}
                target={c.href.startsWith('http') ? '_blank' : undefined}
                rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="group flex items-center gap-3 rounded-xl bg-white dark:bg-slate-800 ring-1 ring-gray-200 dark:ring-slate-700 p-4 shadow-sm hover:ring-blue-400 dark:hover:ring-blue-500 transition"
              >
                <Icon name={c.icon} class="w-6 h-6 text-blue-600 dark:text-blue-400 shrink-0" />
                <span class="min-w-0">
                  <span class="block text-sm font-semibold dark:text-slate-200">{c.label}</span>
                  <span class="block text-sm text-muted dark:text-slate-400 truncate">{c.value}</span>
                </span>
              </a>
            ))
          }
        </div>

        <Button
          variant="primary"
          href="/cv/Josue_Garcia_en.pdf"
          target="_blank"
          icon="tabler:download"
          text="Download CV"
        />
      </div>
    </div>
  </section>
</Layout>
