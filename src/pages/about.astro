---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Caos Image',
    }}
  >
    <Fragment slot="title">
      Full Stack Developer focused on <br />
      <span class="text-accent dark:text-white"> scalable web applications</span>
    </Fragment>

    <Fragment slot="subtitle">
      I have hands-on experience building complete web products using Angular and React on the frontend, and Java +
      Spring Boot on the backend. I enjoy designing clean REST APIs, working with microservices, containerizing with
      Docker, and automating delivery with CI/CD. I’m especially interested in scalable cloud solutions on AWS and
      Azure.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="What I build"
    stats={[
      { title: 'Backend', amount: 'REST' },
      { title: 'Architecture', amount: 'Microservices' },
      { title: 'Delivery', amount: 'CI/CD' },
      { title: 'Cloud', amount: 'AWS/Azure' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Core skills"
    subtitle="A quick overview of the areas I work in across frontend, backend, and cloud."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Frontend',
        description: 'Angular, React, TypeScript, HTML/CSS. Building responsive UIs and integrating with APIs.',
      },
      {
        title: 'Backend',
        description: 'Java 8+, Spring Boot, Spring Security, JWT, REST APIs and microservices.',
      },
      {
        title: 'Cloud & DevOps',
        description: 'Docker, GitHub Actions, Jenkins, AWS, Azure. Deployments and automation for reliable releases.',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'Databases',
        description: 'PostgreSQL, MySQL, Oracle and Redis for caching and performance.',
      },
      {
        title: 'Quality',
        description: 'JUnit 5, Mockito, JaCoCo and SonarQube for testing and maintainable code.',
      },
      {
        title: 'API design',
        description: 'Clear contracts, versioning, documentation, and security-first practices.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Colorful Image',
    }}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="How I work"
    subtitle="I like pragmatic engineering with a focus on reliability, clarity, and iteration."
    items={[
      {
        title: 'Product mindset',
        description: 'I focus on delivering features that solve real problems and are easy to maintain.',
      },
      {
        title: 'Clean architecture',
        description: 'I keep boundaries clear: domain, application, infrastructure, and API contracts.',
      },
      {
        title: 'Automation & quality',
        description: 'Tests + CI/CD to ship confidently and keep code quality measurable.',
      },
    ]}
  />

  <Features2
    title="Based in"
    tagline="Location"
    columns={3}
    items={[
      {
        title: 'Ambato, Tungurahua — Ecuador',
        description: 'Open to remote opportunities and collaborative projects.',
      },
      {
        title: 'Email',
        description: 'josuegarcab2@hotmail.com',
        icon: 'tabler:mail',
      },
      {
        title: 'GitHub',
        description: 'github.com/JosueGarciaAbata',
        icon: 'tabler:brand-github',
      },
    ]}
  />
</Layout>
