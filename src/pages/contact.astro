---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Let's connect" />

  <ContactUs
    id="form"
    title="Send me a message"
    subtitle="If you want to collaborate, discuss an opportunity, or talk about a project, feel free to reach out."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    disclaimer={{
      label: 'By submitting this form, you agree to share your contact details so I can reply.',
    }}
    description="I usually reply within 24–48 hours."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Contact details"
    items={[
      {
        title: 'Email',
        description: 'josuegarcab2@hotmail.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Phone',
        description: '+593 98 493 5153',
        icon: 'tabler:headset',
      },
      {
        title: 'Location',
        description: 'Ambato, Tungurahua, Ecuador',
        icon: 'tabler:map-pin',
      },
      {
        title: 'GitHub',
        description: 'github.com/JosueGarciaAbata',
        icon: 'tabler:brand-github',
      },
      {
        title: 'LinkedIn',
        description: 'linkedin.com/in/josue-joel-garcia-abata-07ab94297',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  />
</Layout>
