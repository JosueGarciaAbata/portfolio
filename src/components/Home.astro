---
import Layout from '~/layouts/PageLayout.astro';

import { Image } from 'astro:assets';
import profile from '~/assets/images/profile.jpg';
import ProjectsHighlightedPosts from '~/components/widgets/ProjectsHighlightedPosts.astro';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = (en: string, es: string) => (lang === 'es' ? es : en);

const metadata = {
  title: t('Full Stack Developer Portfolio — Josue Garcia', 'Portafolio de Desarrollador Full Stack — Josue Garcia'),
  ignoreTitleTemplate: true,
};

const heroStack = ['java', 'spring', 'amazonwebservices', 'docker', 'angular'];

const skillGroups = [
  {
    title: 'Backend',
    icon: 'tabler:server-2',
    skills: [
      { name: 'Java', icon: 'devicon:java' },
      { name: 'Spring Boot', icon: 'devicon:spring' },
      { name: 'Python', icon: 'devicon:python' },
      { name: 'FastAPI', icon: 'devicon:fastapi' },
      { name: 'Node.js', icon: 'devicon:nodejs' },
    ],
  },
  {
    title: 'Frontend',
    icon: 'tabler:device-laptop',
    skills: [
      { name: 'Angular', icon: 'devicon:angular' },
      { name: 'React', icon: 'devicon:react' },
      { name: 'TypeScript', icon: 'devicon:typescript' },
    ],
  },
  {
    title: t('AI', 'IA'),
    icon: 'tabler:brain',
    skills: [
      { name: 'RAG', icon: 'tabler:file-search' },
      { name: 'AI Agents', icon: 'tabler:robot' },
      { name: t('Automation', 'Automatización'), icon: 'tabler:settings-automation' },
      { name: 'Computer Vision', icon: 'tabler:eye' },
    ],
  },
  {
    title: t('Databases', 'Bases de datos'),
    icon: 'tabler:database',
    skills: [
      { name: 'PostgreSQL', icon: 'devicon:postgresql' },
      { name: 'MySQL', icon: 'devicon:mysql' },
      { name: 'Redis', icon: 'devicon:redis' },
      { name: 'Oracle', icon: 'devicon:oracle' },
      { name: 'SQLite', icon: 'devicon:sqlite' },
    ],
  },
  {
    title: t('Architecture', 'Arquitectura'),
    icon: 'tabler:hierarchy-2',
    skills: [
      { name: 'Microservices', icon: 'tabler:topology-star-3' },
      { name: 'REST APIs', icon: 'tabler:api' },
      { name: 'API Gateway', icon: 'tabler:layout-board' },
    ],
  },
  {
    title: t('Testing', 'Pruebas'),
    icon: 'tabler:checkup-list',
    skills: [
      { name: 'JUnit', icon: 'devicon:junit' },
      { name: 'Playwright', icon: 'devicon:playwright' },
      { name: 'Postman', icon: 'devicon:postman' },
      { name: 'k6', icon: 'devicon:k6' },
    ],
  },
  {
    title: t('DevOps & Monitoring', 'DevOps y monitoreo'),
    icon: 'tabler:cloud-cog',
    skills: [
      { name: 'Docker', icon: 'devicon:docker' },
      { name: 'AWS', icon: 'devicon:amazonwebservices' },
      { name: 'Azure', icon: 'devicon:azure' },
      { name: 'GitHub Actions', icon: 'devicon:githubactions' },
      { name: 'Prometheus', icon: 'devicon:prometheus' },
      { name: 'Grafana', icon: 'devicon:grafana' },
    ],
  },
];

const experience = {
  role: t('Software Developer', 'Desarrollador de Software'),
  company: 'Kronhos',
  period: t('May 2026 – Aug 2026', 'May 2026 – Ago 2026'),
  bullets: [
    t(
      'Built a multi-tenant AI support platform with FastAPI, Angular and PostgreSQL, deployed on Azure with CI/CD.',
      'Construí una plataforma de soporte con IA multi-tenant con FastAPI, Angular y PostgreSQL, desplegada en Azure con CI/CD.'
    ),
    t(
      'Added a RAG pipeline (pgvector) and an agent orchestrator connected to WhatsApp.',
      'Añadí un pipeline RAG (pgvector) y un orquestador de agentes conectado a WhatsApp.'
    ),
  ],
  stats: [
    { value: '0%', label: t('HTTP errors under load', 'errores HTTP bajo carga') },
    { value: '2.31 s', label: t('p95 latency at 10 users', 'latencia p95 con 10 usuarios') },
    { value: '632', label: t('requests load-tested (k6)', 'peticiones probadas (k6)') },
  ],
  images: [
    {
      src: '/images/projects/kronhos/assistant.png',
      alt: t('Kronhos admin panel with the assistant chat', 'Panel de Kronhos con el chat del asistente'),
    },
    {
      src: '/images/projects/kronhos/conversations.png',
      alt: t('Kronhos admin panel listing WhatsApp conversations', 'Panel de Kronhos con conversaciones de WhatsApp'),
    },
  ],
  tags: [
    { name: 'FastAPI', icon: 'devicon:fastapi' },
    { name: 'Angular', icon: 'devicon:angular' },
    { name: 'PostgreSQL', icon: 'devicon:postgresql' },
    { name: 'pgvector', icon: 'tabler:vector-triangle' },
    { name: 'Azure', icon: 'devicon:azure' },
  ],
  href: getPermalink('projects/kronhos-ai-assistant', 'post'),
};

const freelance = {
  role: t('Freelance Full Stack Developer', 'Desarrollador Full Stack Freelance'),
  period: t('Jan 2025 – Present', 'Ene 2025 – Actualidad'),
  bullets: [
    t(
      'Developed and deployed full-stack web applications end to end with Angular, NestJS, PostgreSQL and Docker.',
      'Desarrollé y desplegué aplicaciones web full stack de punta a punta con Angular, NestJS, PostgreSQL y Docker.'
    ),
    t(
      'Built real-time features with WebSockets and JWT authentication, Playwright system tests, and CI/CD with production deployment on a VPS with Nginx, SSL and Cloudflare.',
      'Construí funciones en tiempo real con WebSockets y autenticación JWT, pruebas de sistema con Playwright, y CI/CD con despliegue en producción en un VPS con Nginx, SSL y Cloudflare.'
    ),
  ],
  tags: [
    { name: 'Angular', icon: 'devicon:angular' },
    { name: 'NestJS', icon: 'devicon:nestjs' },
    { name: 'PostgreSQL', icon: 'devicon:postgresql' },
    { name: 'Docker', icon: 'devicon:docker' },
    { name: 'WebSockets', icon: 'tabler:plug-connected' },
  ],
  image: {
    src: '/images/projects/petsafe/login.png',
    alt: t('Login screen of a veterinary clinic management system', 'Pantalla de inicio de sesión de un sistema de gestión veterinaria'),
  },
};

const chipSm =
  'inline-flex items-center gap-1.5 rounded-full bg-gray-100 dark:bg-white/5 ring-1 ring-gray-200 dark:ring-white/10 px-2.5 py-1 text-xs font-semibold text-default dark:text-slate-200';

// Newest first: the snake starts at the top with the latest and ends at the bottom with the oldest.
const timelineItems = [
  {
    kind: 'milestone',
    title: 'AWS Certified AI Practitioner',
    period: t('Sep 2026', 'Sep 2026'),
    text: t('Certified in AI services on AWS.', 'Certificado en servicios de IA en AWS.'),
    h: 130,
  },
  {
    kind: 'job',
    title: experience.role,
    company: experience.company,
    period: experience.period,
    text: t(
      'A multi-tenant RAG support assistant on a web chat and WhatsApp, deployed on Azure with CI/CD.',
      'Un asistente de soporte RAG multi-tenant en chat web y WhatsApp, desplegado en Azure con CI/CD.'
    ),
    tags: experience.tags,
    href: experience.href,
    h: 215,
  },
  {
    kind: 'job',
    title: freelance.role,
    period: freelance.period,
    text: t(
      'Full-stack web applications end to end, with real-time features, Playwright tests and CI/CD to a VPS.',
      'Aplicaciones web full stack de punta a punta, con funciones en tiempo real, pruebas con Playwright y CI/CD a un VPS.'
    ),
    tags: freelance.tags,
    href: getPermalink('projects/petsafe-veterinary-clinic-management', 'post'),
    linkLabel: t('See an example', 'Ver un ejemplo'),
    h: 215,
  },
  {
    kind: 'milestone',
    title: t('B.Eng. in Software Engineering', 'Ingeniería en Software'),
    period: t('Dec 2022 – Jun 2027', 'Dic 2022 – Jun 2027'),
    text: 'Universidad Técnica de Ambato',
    h: 130,
  },
];

const snakeX = [44, 56];
let snakeAcc = 0;
const snakeNodes = timelineItems.map((item, i) => {
  const y = snakeAcc + item.h / 2;
  snakeAcc += item.h;
  return { ...item, y, x: snakeX[i % 2] };
});
const snakeHeight = snakeAcc;
let snakePath = `M ${snakeNodes[0].x} 0 L ${snakeNodes[0].x} ${snakeNodes[0].y}`;
for (let i = 1; i < snakeNodes.length; i++) {
  const a = snakeNodes[i - 1];
  const b = snakeNodes[i];
  const m = (b.y - a.y) / 2;
  snakePath += ` C ${a.x} ${a.y + m} ${b.x} ${b.y - m} ${b.x} ${b.y}`;
}
snakePath += ` L ${snakeNodes[snakeNodes.length - 1].x} ${snakeHeight}`;

const certifications = [
  {
    name: 'AWS Certified AI Practitioner',
    issued: t('Issued Sep 2026 - valid until Sep 2029', 'Emitida sep 2026 - vigente hasta sep 2029'),
    image: '/images/certifications/aws-ai-practitioner.png',
    fit: 'object-cover object-top',
    cta: t('Verify on AWS', 'Verificar en AWS'),
    href: 'https://cp.certmetrics.com/amazon/en/public/verify/credential/D8A08634715D4AAC8046DC7B2128784B',
  },
  {
    name: 'EF SET English - B2 (Upper Intermediate)',
    issued: t('Score 54/100 - Nov 2026', 'Puntaje 54/100 - nov 2026'),
    image: '/images/certifications/efset-b2.svg',
    fit: 'object-contain p-1',
    cta: t('Verify on EF SET', 'Verificar en EF SET'),
    href: 'https://cert.efset.org/es/SXoScf',
  },
];

const contactLinks = [
  { label: 'Email', value: 'josuegarcab2@gmail.com', href: 'mailto:josuegarcab2@gmail.com', icon: 'tabler:mail' },
  {
    label: 'LinkedIn',
    value: 'in/josué-garcía',
    href: 'https://www.linkedin.com/in/josu%C3%A9-garc%C3%ADa-07ab94297/',
    icon: 'tabler:brand-linkedin',
  },
  {
    label: 'GitHub',
    value: 'JosueGarciaAbata',
    href: 'https://github.com/JosueGarciaAbata',
    icon: 'tabler:brand-github',
  },
];

const heroLinks = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/josu%C3%A9-garc%C3%ADa-07ab94297/',
    icon: 'tabler:brand-linkedin',
  },
  { label: 'GitHub', href: 'https://github.com/JosueGarciaAbata', icon: 'tabler:brand-github' },
  { label: 'YouTube', href: 'https://www.youtube.com/@user-jsg204', icon: 'tabler:brand-youtube' },
  { label: 'Email', href: 'mailto:josuegarcab2@gmail.com', icon: 'tabler:mail' },
];

const cvText = t('Download CV', 'Descargar CV');
const cvHref = t('/cv/Josue_Garcia_en.pdf', '/cv/Josue_Garcia_es.pdf');

const chip =
  'tag-chip inline-flex items-center gap-2 rounded-full bg-white dark:bg-white/5 ring-1 ring-gray-200 dark:ring-white/10 text-default dark:text-slate-200 pl-2 pr-3.5 py-1.5 text-sm font-semibold';
const card = 'rounded-xl bg-white dark:bg-slate-800 ring-1 ring-gray-200 dark:ring-slate-700 shadow-sm';
const h2 = 'text-3xl md:text-4xl font-bold tracking-tight font-heading';
const section = 'scroll-mt-[96px] md:scroll-mt-[88px]';
---

<Layout metadata={metadata} lang={lang}>
  <!-- Hero ******************* -->

  <div id="home" class={section}>
    <section class="relative overflow-hidden">
      <div class="ed-glow" aria-hidden="true"></div>
      <div class="relative max-w-screen-2xl mx-auto px-4 md:px-6 min-h-[88svh] pt-28 pb-12 grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <h1 class="hero-title">
            <span class="ln" style="--d:80ms"><span>Josué</span></span>
            <span class="ln" style="--d:200ms"><span><em class="grad-i">García</em></span></span>
          </h1>

          <h2 class="hero-role ln" style="--d:340ms">
            <span>{t('Full Stack Developer', 'Desarrollador Full Stack')}</span>
          </h2>
          <p class="hero-role-i ln" style="--d:420ms"><span><em class="grad-i">{t('Software Engineer', 'Ingeniero de Software')}</em></span></p>
          <p class="hero-sub ln" style="--d:500ms">
            <span>
              {
                t(
                  '2 years of experience building scalable applications, APIs, dashboards, microservice systems and more.',
                  '2 años de experiencia construyendo aplicaciones escalables, APIs, dashboards, sistemas de microservicios y más.'
                )
              }
            </span>
          </p>

          <div class="mt-10 fade-up" style="--d:560ms">
            <div class="flex flex-wrap items-center gap-3">
              <Button variant="primary" href={cvHref} target="_blank" icon="tabler:download" text={cvText} />
              <Button text={t('View projects', 'Ver proyectos')} href="#projects" />
            </div>
            <div class="mt-6 flex items-center gap-4">
              {
                heroLinks.map((l) => (
                  <a
                    href={l.href}
                    target={l.href.startsWith('http') ? '_blank' : undefined}
                    rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    aria-label={l.label}
                    title={l.label}
                    class="text-muted dark:text-slate-300 hover:text-primary dark:hover:text-blue-400 hover:-translate-y-0.5 transition"
                  >
                    <Icon name={l.icon} class="w-7 h-7" />
                  </a>
                ))
              }
            </div>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-4 fade-up" style="--d:640ms" aria-hidden="true">
            {
              heroStack.map((name, i) => (
                <span class="tech-tile tech-float" style={`--i:${i}`}>
                  <Icon name={`devicon:${name}`} class="h-7 w-7" />
                </span>
              ))
            }
          </div>
        </div>

        <div class="lg:col-span-4 flex justify-center lg:justify-end fade-up" style="--d:300ms">
          <Image
            src={profile}
            alt="Josue Garcia"
            width={640}
            height={820}
            class="hero-photo h-80 w-64 md:h-[28rem] md:w-80 lg:h-[32rem] lg:w-[28rem] object-cover object-[50%_15%]"
          />
        </div>
      </div>
    </section>
  </div>

  <!-- Experience ************** -->

  <section id="experience" class={section}>
    <div class="max-w-screen-2xl mx-auto px-4 md:px-6 py-16 md:py-20">
      <h2 class="ed-h2 mb-10 md:mb-12" set:html={t("Where I've <em>worked.</em>", 'Donde he <em>trabajado.</em>')} />

      <div class="relative mx-auto max-w-5xl lg:h-[var(--snake-h)]" style={`--snake-h:${snakeHeight}px`}>
        <div class="pointer-events-none absolute left-1/2 top-1/2 hidden h-[460px] w-[460px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-500/10 blur-3xl lg:block" aria-hidden="true"></div>

        <div class="snake-clip absolute inset-0 hidden lg:block" aria-hidden="true">
          <svg class="absolute inset-0 h-full w-full opacity-60 blur-[7px]" viewBox={`0 0 100 ${snakeHeight}`} preserveAspectRatio="none">
            <path d={snakePath} fill="none" stroke="#3b82f6" stroke-width="7" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
          </svg>
          <svg class="absolute inset-0 h-full w-full" viewBox={`0 0 100 ${snakeHeight}`} preserveAspectRatio="none">
            <defs>
              <linearGradient id="snake-gradient" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#60a5fa"></stop>
                <stop offset="0.55" stop-color="#3b82f6"></stop>
                <stop offset="1" stop-color="#8b5cf6" stop-opacity="0.5"></stop>
              </linearGradient>
            </defs>
            <path d={snakePath} fill="none" stroke="url(#snake-gradient)" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
          </svg>
        </div>

        <ol class="relative ml-2 border-l border-slate-300 dark:border-slate-700 lg:ml-0 lg:border-0">
          {
            snakeNodes.map((item, i) => (
              <Fragment>
                <span
                  class:list={[
                    'absolute z-10 hidden -translate-x-1/2 -translate-y-1/2 rounded-full lg:block',
                    item.kind === 'job'
                      ? 'h-5 w-5 bg-blue-500 ring-[6px] ring-blue-500/25'
                      : 'h-3.5 w-3.5 bg-slate-400 ring-4 ring-slate-400/20',
                  ]}
                  style={`left:${item.x}%;top:${item.y}px`}
                >
                  {item.kind === 'job' && (
                    <span class="absolute inset-0 animate-ping rounded-full bg-blue-400/60 motion-reduce:hidden" />
                  )}
                </span>
                <li
                  class="relative pb-8 pl-8 lg:absolute lg:left-[var(--left)] lg:top-[var(--top)] lg:w-[40%] lg:-translate-y-1/2 lg:p-0"
                  style={`--top:${item.y}px;--left:${i % 2 === 0 ? 0 : 60}%`}
                >
                  <span class="absolute -left-[7px] top-2 h-3.5 w-3.5 rounded-full bg-blue-500 lg:hidden" />
                  <span
                    class:list={[
                      'absolute top-1/2 hidden h-px w-[10%] lg:block',
                      i % 2 === 0
                        ? 'left-full bg-gradient-to-r from-blue-500/10 to-blue-500/70'
                        : 'right-full bg-gradient-to-l from-blue-500/10 to-blue-500/70',
                    ]}
                  />
                  <div class="snake-reveal" data-side={i % 2 === 0 ? 'left' : 'right'}>
                    <div
                      class={`${card} p-5 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-blue-500/10 hover:ring-blue-400/50`}
                    >
                      <p class="text-sm text-muted dark:text-slate-400">{item.period}</p>
                      <h3 class="mt-1 text-xl font-bold leading-snug text-default dark:text-slate-100">
                        {item.title}
                        {item.company && <span class="text-blue-600 dark:text-blue-400"> @ {item.company}</span>}
                      </h3>
                      <p class="mt-2 text-sm text-muted dark:text-slate-300">{item.text}</p>
                      {item.tags && (
                        <div class="mt-3 flex flex-wrap gap-1.5">
                          {item.tags.map((tag) => (
                            <span class={chipSm}>
                              <Icon name={tag.icon} class="h-4 w-4" />
                              {tag.name}
                            </span>
                          ))}
                        </div>
                      )}
                      {item.href && (
                        <a href={item.href} class="cta-link mt-3 text-sm">
                          {item.linkLabel ?? t('See the project', 'Ver el proyecto')}
                          <Icon name="tabler:arrow-up-right" class="w-4 h-4" />
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              </Fragment>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Featured projects ************** -->

  <div id="projects" class={section}>
    <ProjectsHighlightedPosts
      classes={{ container: 'max-w-screen-2xl' }}
      title={t('Featured <em>projects.</em>', 'Proyectos <em>destacados.</em>')}
      linkText={t('All projects', 'Todos los proyectos')}
      postIds={[
        'textflow-secure-latex-editor',
        'brunexa-bank',
        'vehicle-monitoring-plate-recognition',
        'iron-zone-gym-management-odoo',
      ]}
    />
  </div>

  <!-- Skills ************************* -->

  <section id="skills" class={section}>
    <div class="max-w-screen-2xl mx-auto px-4 md:px-6 py-16 md:py-28">
      <h2 class="ed-h2 mb-10 md:mb-14" set:html={t('What I <em>use.</em>', 'Lo que <em>uso.</em>')} />

      <div class="grid md:grid-cols-2 gap-x-16 gap-y-12 md:gap-y-14">
        {
          skillGroups.map((group) => (
            <div class="sk-group">
              <h3 class="sk-title"><span class="sk-skew">{group.title}</span></h3>
              <div class="sk-line"></div>
              <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-5">
                {group.skills.map((skill, i) => (
                  <li class="sk-item" style={`--i:${i}`}>
                    <span class="sk-ico">
                      <Icon name={skill.icon} class="h-7 w-7" aria-hidden="true" />
                    </span>
                    <span class="text-lg">{skill.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- About + Certification ************************* -->

  <section id="about" class={section}>
    <div class="max-w-screen-2xl mx-auto px-4 md:px-6 py-16 md:py-28">
      <h2 class="ed-h2 mb-8" set:html={t('About <em>me.</em>', 'Sobre <em>mí.</em>')} />
      <p class="text-xl md:text-2xl text-muted dark:text-slate-300 leading-relaxed max-w-3xl">
        {
          t(
            'Full Stack Developer focused on scalable applications: REST APIs with clean architecture, databases, CI/CD pipelines and Python automation.',
            'Desarrollador Full Stack enfocado en aplicaciones escalables: APIs REST con arquitectura limpia, bases de datos, pipelines de CI/CD y automatizaciones con Python.'
          )
        }
      </p>
      <h3 class="mt-14 mb-6 text-2xl md:text-3xl font-semibold text-default dark:text-slate-100">
        {t('Outside of work', 'Fuera del trabajo')}
      </h3>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class={`${card} p-5 flex items-center gap-4`}>
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-300">
            <Icon name="tabler:brain" class="w-6 h-6" />
          </span>
          <div>
            <div class="font-semibold text-default dark:text-slate-100">{t('Research', 'Investigación')}</div>
            <div class="text-sm text-muted dark:text-slate-400">
              {t('Reading and studying AI papers', 'Leer y estudiar papers de inteligencia artificial')}
            </div>
          </div>
        </div>
        <div class={`${card} p-5 flex items-center gap-4`}>
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-300">
            <Icon name="tabler:chef-hat" class="w-6 h-6" />
          </span>
          <div>
            <div class="font-semibold text-default dark:text-slate-100">{t('Cooking', 'Cocinar')}</div>
            <div class="text-sm text-muted dark:text-slate-400">
              {t('Beef stew is my favorite dish', 'Mi plato favorito es el estofado de carne')}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Certifications ************************* -->

  <section id="certifications" class={section}>
    <div class="max-w-screen-2xl mx-auto px-4 md:px-6 py-16 md:py-28">
      <h2 class="ed-h2 mb-10 md:mb-14" set:html={t('My <em>certifications.</em>', 'Mis <em>certificaciones.</em>')} />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          certifications.map((c) => (
            <a
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[card, 'cert-card flex flex-col overflow-hidden transition']}
            >
              <img
                src={c.image}
                alt={t(`${c.name} credential`, `Credencial ${c.name}`)}
                class:list={['w-full h-44', c.fit, 'bg-white']}
                loading="lazy"
                decoding="async"
              />
              <span class="flex flex-1 flex-col p-5">
                <span class="flex items-center gap-1.5 text-lg font-bold dark:text-slate-200">
                  <Icon name="tabler:certificate" class="w-5 h-5 text-primary dark:text-blue-400 shrink-0" />
                  {c.name}
                </span>
                <span class="block text-sm text-muted dark:text-slate-400 mt-1">{c.issued}</span>
                <span class="inline-flex items-center gap-1 text-sm font-semibold text-primary dark:text-blue-300 mt-auto pt-4">
                  {c.cta}
                  <Icon name="tabler:external-link" class="w-4 h-4" />
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact *********************** -->

  <section id="contact" class={section}>
    <div class="max-w-screen-2xl mx-auto px-4 md:px-6 py-20 md:py-32">
      <h2 class="ed-h2 ed-h2-xl mb-10" set:html={t("Let's build <em>together.</em>", 'Construyamos <em>juntos.</em>')} />

      <a href="mailto:josuegarcab2@gmail.com" class="mail-link">josuegarcab2@gmail.com</a>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        {
          contactLinks.map((c) => (
            <a
              href={c.href}
              target={c.href.startsWith('http') ? '_blank' : undefined}
              rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class:list={[card, 'cert-card flex items-center gap-3 p-4 transition']}
            >
              <Icon name={c.icon} class="w-6 h-6 text-primary dark:text-blue-400 shrink-0" />
              <span class="min-w-0">
                <span class="block text-sm font-semibold dark:text-slate-200">{c.label}</span>
                <span class="block text-sm text-muted dark:text-slate-400 truncate">{c.value}</span>
              </span>
            </a>
          ))
        }
      </div>

      <Button variant="primary" href={cvHref} target="_blank" icon="tabler:download" text={cvText} />
    </div>
  </section>
</Layout>

<style is:global>
  /* The timeline is taller than the viewport, so it scrolls normally instead of being stacked under the next section. */
  main:has(#home) > #experience {
    position: relative;
    top: auto;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .snake-clip {
        animation: snake-draw linear both;
        animation-timeline: view();
        animation-range: entry 15% cover 55%;
      }
      .snake-reveal {
        animation: snake-in-left linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 65%;
      }
      .snake-reveal[data-side='right'] {
        animation-name: snake-in-right;
      }
    }
  }
  @keyframes snake-draw {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes snake-in-left {
    from {
      opacity: 0;
      transform: translateX(-32px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes snake-in-right {
    from {
      opacity: 0;
      transform: translateX(32px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
